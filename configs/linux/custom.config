# Custom kernel module configuration fragment
# Converted from scripts/config --module commands
# This file will be applied on top of the base defconfig

# DRM (Direct Rendering Manager) support
CONFIG_DRM=m
CONFIG_DRM_IMX=m
CONFIG_DRM_IMX_LCDIF=m
CONFIG_DRM_IMX_LDB=m
CONFIG_DRM_PANEL_RONBO_RB070D30=m

# MIPI DSI support
CONFIG_IMX8MP_MIPI_DSI=m
CONFIG_MIPI_DSI=m

# Touchscreen support
CONFIG_TOUCHSCREEN_ATMEL_MXT=m
CONFIG_TOUCHSCREEN_ILI210X=m

# Serial support
CONFIG_SERIAL_IMX=m

# WiFi support
CONFIG_BRCMFMAC=m
CONFIG_ATH10K_SDIO=m
CONFIG_ATH6KL_SDIO=m

# Bluetooth support
CONFIG_BT=m
CONFIG_BT_HCIUART=m

# NFC support
CONFIG_NFC=m
CONFIG_NFC_NCI=m
CONFIG_NFC_NXP_NCI_SPI=m

# Audio support
CONFIG_SND_SOC_FSL_SAI=m
CONFIG_SND_SOC_WM8904=m

# RTC support
CONFIG_RTC_DRV_DS1307=m
